# ─────────────────────────────────────────────────────────────────────────────
# Passidoc — Variables de production
# 1. Copier ce fichier : cp .env.prod.example .env.prod
# 2. Remplir TOUTES les valeurs marquées <...>
# 3. Ne jamais commiter .env.prod (déjà dans .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
DB_USER=passidoc_user
DB_PASSWORD=<mot_de_passe_fort_ici>      # ex: openssl rand -base64 32

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<secret_jwt_fort_ici>         # ex: openssl rand -base64 64
JWT_EXPIRES_IN=7d

# ── Reset BDD (endpoint admin — garder très secret) ──────────────────────────
RESET_SECRET=<secret_reset_fort_ici>

# ── MinIO (stockage fichiers) ─────────────────────────────────────────────────
MINIO_ACCESS_KEY=passidoc_minio          # nom d'utilisateur MinIO
MINIO_SECRET_KEY=<mot_de_passe_minio>    # ex: openssl rand -base64 32

# ── IA Anthropic (optionnel) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=                       # laisser vide pour désactiver

# ── Email SMTP (optionnel — notifications) ────────────────────────────────────
MAIL_HOST=smtp.afym.re                   # ou smtp.gmail.com, etc.
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=passidoc@afym.re
MAIL_PASS=<mot_de_passe_smtp>
MAIL_FROM=passidoc@afym.re

# ── URL de l'application ──────────────────────────────────────────────────────
APP_URL=https://passidoc.afym.re        # domaine final sans slash
