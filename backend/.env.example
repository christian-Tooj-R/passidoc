# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=passidoc_user
DB_PASSWORD=your_password_here
DB_NAME=passidoc_db

# JWT
JWT_SECRET=your_jwt_secret_here

# Reset database (endpoint POST /setup/reset — garder secret !)
RESET_SECRET=your_very_secret_reset_token_here
JWT_EXPIRES_IN=7d

# 2FA
TOTP_APP_NAME=Passidoc

# Groq IA (gratuit — console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Storage (MinIO)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=passidoc-documents

# Email (SMTP) — notifications congés
# Laisser MAIL_HOST vide pour désactiver les emails (mode log uniquement)
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@domain.com
MAIL_PASS=your_email_password
MAIL_FROM=passidoc@afym.re

# URLs de l'application (pour les liens dans les emails)
APP_URL=https://your-app-domain.com
API_URL=https://your-api-domain.com/api
